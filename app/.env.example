# Public client-side values only. Do not put server secrets in Expo public env vars.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
EXPO_PUBLIC_NAVER_PLACE_SEARCH_ENDPOINT=

# Do not store NAVER_MAP_CLIENT_SECRET in the mobile app.

# Supabase project (Settings -> API). The anon key is safe to expose client-side; it's
# constrained by the row level security policies in supabase/schema.sql.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
